{
  "name": "the-library",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "cdk": "pnpm --filter @library/infra exec cdk",
    "amplify-proxy": "tsx scripts/amplify-proxy.ts",
    "check-hosting": "bash scripts/check-hosting.sh",
    "icons": "bash scripts/icons.sh",
    "deploy": "pnpm --filter @library/web build && pnpm cdk deploy -c stage=prod --require-approval never",
    "seed-dev": "tsx scripts/seed-dev.ts",
    "create-user": "bash scripts/create-user.sh",
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "gmail:check": "tsx scripts/gmail-check.ts",
    "backfill": "tsx scripts/backfill.ts",
    "reprocess": "tsx scripts/reprocess.ts",
    "rebuild-senders": "tsx scripts/rebuild-senders.ts",
    "topics": "tsx scripts/topics.ts",
    "enrich": "tsx scripts/enrich.ts",
    "stories": "tsx scripts/stories.ts",
    "narrative": "tsx scripts/narrative.ts",
    "history-backfill": "tsx scripts/history-backfill.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1148.0",
    "@aws-sdk/client-cloudformation": "^3.1148.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-lambda": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-ssm": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@eslint/js": "^10.0.1",
    "@library/core": "workspace:*",
    "@smithy/node-http-handler": "^4.12.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
